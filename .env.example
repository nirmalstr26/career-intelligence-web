# CareerAI frontend environment — PUBLIC values only.
# Never put secrets here: there is NO Google client secret and NO CareerAI session
# secret in the browser. The CareerAI session lives in an HttpOnly cookie set by
# the backend, and Google uses only the public OAuth Client ID.

# Base URL of the CareerAI FastAPI backend, INCLUDING the /api/v1 prefix.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# PUBLIC Google OAuth 2.0 "Web application" Client ID (…apps.googleusercontent.com).
# Create it in Google Cloud Console → APIs & Services → Credentials, and add your
# dev origin (e.g. http://localhost:5173) under "Authorized JavaScript origins".
# This value is public by design. Leave blank to run the UI without Google sign-in.
VITE_GOOGLE_CLIENT_ID=
